int loadPlayer(const char *filename, struct playerData *player)
{
    FILE *file = fopen(filename, "r");
    if (!file) return 0;

    char line[128];
    while (fgets(line, sizeof(line), file)) 
    {
        if (sscanf(line, "  \"name\": \"%50[^\"]\"", player->name) == 1) continue;
        if (sscanf(line, "  \"health\": %d", &player->health) == 1) continue;
        if (sscanf(line, "  \"mana\": %d", &player->mana) == 1) continue;
        if (sscanf(line, "  \"level\": %d", &player->level) == 1) continue;
    }

    fclose(file);
    return 1; 
}


void savePlayer(struct playerData *player) {

    char filename[26];
    //sprintf(filename, "characters/%s.json", player->name);
    sprintf(filename, "%s.json", player->name);

    FILE *file = fopen(filename, "w");

    if (file == NULL) {
        printf("Error opening file! %s \n", strerror(errno));
        return;
    }

    fprintf(file, "{\n");
    fprintf(file, "\"name\": \"%s\",\n", player->name);
    fprintf(file, "\"health\": %d,\n", player->health);
    fprintf(file, "\"mana\": %d,\n", player->mana);
    fprintf(file, "\"level\": %d\n", player->level);
    fprintf(file, "}\n");

    fclose(file);
    printf("\nAccount loaded!\n\n");
    //
    //
    printf("Type 'M' to enter menu!\n\n"); 

    char mainMenuEnter[2];
    fgets(mainMenuEnter, sizeof(mainMenuEnter), stdin);

    if(mainMenuEnter[0] == 'M' || mainMenuEnter[0] == 'm')
    {
        mainMenu();
    }
}



